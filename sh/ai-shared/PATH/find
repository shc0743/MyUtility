#!/usr/bin/env bash
set -euo pipefail

REAL_FIND="$PREFIX/bin/find"
BLACKLIST="$HOME/ai-shared/rules/filesystem-scanning-blocker.txt"

if [[ ! -f "$BLACKLIST" ]]; then
    exec "$REAL_FIND" "$@"
fi

#---------- 解析 find 参数，提取所有搜索起始路径 ----------
args=("$@")
n=${#args[@]}
paths=()
i=0

while (( i < n )); do
    arg="${args[$i]}"
    case "$arg" in
        --)
            # 选项结束，开始收集路径（直到遇到 - 开头或结束）
            (( ++i ))
            while (( i < n )) && [[ "${args[$i]}" != -* ]]; do
                paths+=("${args[$i]}")
                (( ++i ))
            done
            break
            ;;
        -[HLP]*|-D*|-O*)
            # 处理 find 的选项：-H, -L, -P 及其组合不消耗额外参数
            # -D 消耗下一个参数，-O 可能消耗下一个参数
            if [[ "$arg" == -D ]]; then
                ((i+=2))  # 跳过 -D 和它的参数
            elif [[ "$arg" == -O ]]; then
                ((i+=2))  # 跳过 -O 和它的参数
            elif [[ "$arg" == -O[0-9]* ]]; then
                (( ++i ))   # -O2 不消耗额外参数
            else
                # -H, -L, -P 或它们的组合，不消耗额外参数
                (( ++i ))
            fi
            ;;
        -*)
            # 遇到其他以 - 开头的参数，这是表达式开始，没有提供路径
            break
            ;;
        *)
            # 第一个非选项参数，从这里开始收集所有连续的非 - 参数作为路径
            while (( i < n )) && [[ "${args[$i]}" != -* ]]; do
                paths+=("${args[$i]}")
                (( ++i ))
            done
            break
            ;;
    esac
done

# 如果没有提取到任何路径，默认搜索当前目录
if [ ${#paths[@]} -eq 0 ]; then
    paths=(".")
fi

#---------- 检查目标路径是否在黑名单中 ----------
check_path() {
    local target="$1"
    local rp
    # 解析真实路径，路径可能不存在，此时忽略（find 会在运行时报错）
    rp="$(realpath "$target" 2>/dev/null)" || return 0

    while IFS= read -r line; do
        # 忽略空行和 # 开头的注释
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ "$rp" == "$line" ]]; then
            echo Filesystem scanner blocked # FIXME: Edit to your own prompt text
            kill -9 $$
        fi
    done < "$BLACKLIST"
}

for p in "${paths[@]}"; do
    check_path "$p"
done

exec "$REAL_FIND" "$@"
