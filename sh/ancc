#!/usr/bin/env bash
ancc() {
    if [[ $# -eq 0 ]]; then
        echo "Usage: ancc file1.java [file2.java ...]"
        return 1
    fi

    local java_files=("$@")
    local main_class_name=$(basename "${java_files[0]}" .java)
    local temp_dir=$(mktemp -d)
    local dex_out="$temp_dir/dexout"

    # 编译
    if ! javac --release 11 -cp "$android_jar" -d "$temp_dir" "${java_files[@]}"; then
        echo "Build FAILED: Java compilation error"
        rm -rf "$temp_dir"
        return 1
    fi

    # 收集 .class（含子目录）
    local class_files=()
    while IFS= read -r -d '' file; do
        class_files+=("$file")
    done < <(find "$temp_dir" -name "*.class" -type f -print0)

    if [[ ${#class_files[@]} -eq 0 ]]; then
        echo "Build FAILED: No .class files generated in $temp_dir"
        find "$temp_dir" -type f
        rm -rf "$temp_dir"
        return 1
    fi

    echo "Packaging ${#class_files[@]} class files"

    # d8 输出到独立目录，避免污染当前目录
    mkdir -p "$dex_out"
    local d8_input_args=()
    if [[ ${#class_files[@]} -gt 100 ]]; then
        local arg_file="$temp_dir/d8-class-files.txt"
        : > "$arg_file"
        printf '%s\n' "${class_files[@]}" > "$arg_file"
        d8_input_args=("@$arg_file")
    else
        d8_input_args=("${class_files[@]}")
    fi
    if ! d8 --release --min-api 26 --lib "$android_jar" --output "$dex_out" "${d8_input_args[@]}"; then
        echo "Build FAILED: D8 error"
        rm -rf "$temp_dir"
        return 1
    fi

    # 按标准命名顺序收集 classes.dex / classes2.dex / classes3.dex ...
    local dex_names=()
    local i=1 name
    while :; do
        if [[ $i -eq 1 ]]; then
            name="classes.dex"
        else
            name="classes${i}.dex"
        fi
        [[ -f "$dex_out/$name" ]] || break
        dex_names+=("$name")
        ((i++))
    done

    local dex_count=${#dex_names[@]}

    if [[ $dex_count -eq 0 ]]; then
        echo "Build FAILED: could not find classes to pack"
        find "$dex_out" -type f
        rm -rf "$temp_dir"
        return 1
    fi

    if [[ $dex_count -eq 1 ]]; then
        chmod -w "$dex_out/classes.dex"
        mv -f "$dex_out/classes.dex" "${main_class_name}.dex"
        echo "Built ${main_class_name}.dex from ${#java_files[@]} Java file(s)"
    else
        local out_apk="$PWD/${main_class_name}.apk"
        rm -f "$out_apk"

        if command -v zip >/dev/null 2>&1; then
            if ! ( cd "$dex_out" && zip -q -X "$out_apk" "${dex_names[@]}" ); then
                echo "Build FAILED: failed to package $out_apk"
                rm -rf "$temp_dir"
                return 1
            fi
        else
            echo "WARN: zip not found"
            if ! ( cd "$dex_out" && jar cf "$out_apk" "${dex_names[@]}" ); then
                echo "Build FAILED: failed to package $out_apk"
                rm -rf "$temp_dir"
                return 1
            fi
        fi

        if [[ ! -f "$out_apk" ]]; then
            echo "Build FAILED: $out_apk not created"
            rm -rf "$temp_dir"
            return 1
        fi

        chmod -w "$out_apk"
        echo "Built ${main_class_name}.apk from ${#java_files[@]} Java file(s)"
    fi

    # 清理临时目录
    rm -rf "$temp_dir"

    # # 多文件提示
    # if [[ ${#java_files[@]} -gt 1 ]]; then
        # echo "Available classes in dex:"
        # for java_file in "${java_files[@]}"; do
            # echo "  $(basename "$java_file" .java)"
        # done
    # fi
}

ancc "$@"

