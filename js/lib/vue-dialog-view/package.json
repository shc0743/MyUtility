{
    "name": "vue-dialog-view",
    "version": "1.8.1",
    "description": "A modern Vue 3 dialog component using native dialog element",
    "type": "module",
    "main": "./dist/dialog-view.umd.js",
    "module": "./dist/dialog-view.es.js",
    "types": "./dist/index.d.ts",
    "style": "./dist/vue-dialog-view.css",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/dialog-view.es.js",
            "require": "./dist/dialog-view.umd.js"
        },
        "./unobfuscated": {
            "types": "./dist/unobfuscated.d.ts",
            "import": "./dist/unobfuscated.es.js",
            "require": "./dist/unobfuscated.umd.js"
        },
        "./cssless": {
            "types": "./dist/cssless.d.ts",
            "import": "./dist/cssless.es.js",
            "require": "./dist/cssless.umd.js"
        },
        "./cssless-obfuscated": {
            "types": "./dist/cssless-obfuscated.d.ts",
            "import": "./dist/cssless-obfuscated.es.js",
            "require": "./dist/cssless-obfuscated.umd.js"
        },
        "./style": {
            "default": "./dist/vue-dialog-view.css"
        },
        "./style-obfuscated": {
            "default": "./dist/vue-dialog-view-obfuscated.css"
        }
    },
    "files": [
        "src/**",
        "dist/**",
        "README.md",
        "tsconfig.json",
        "vite.config.ts",
        "obfuscate-classes.mjs",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "clean": "rimraf dist",
        "obfuscate": "node ./obfuscate-classes.mjs",
        "build": "npm run clean && npm run obfuscate && npm run type-check && npm run build-only",
        "type-check": "vue-tsc --noEmit",
        "build-only": "npm run build-only:normal && npm run build-only:unobfuscated && npm run build-only:cssless && npm run build-only:cssless-obfuscated",
        "build-only:normal": "vite build",
        "build-only:unobfuscated": "vite build --mode unobfuscated",
        "build-only:cssless": "vite build --mode cssless",
        "build-only:cssless-obfuscated": "vite build --mode cssless-obfuscated",
        "preview": "vite preview"
    },
    "peerDependencies": {
        "vue": "^3.3.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.5",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-css-injected-by-js": "^4.0.1",
        "vite-plugin-dts": "^4.5.4",
        "vue": "^3.5.30",
        "vue-tsc": "^3.1.1"
    },
    "keywords": [
        "front-end",
        "vue",
        "dialog",
        "dialog-view",
        "html5"
    ],
    "author": "chcs1013",
    "license": "Unlicense",
    "bugs": {
        "url": "https://github.com/shc0743/MyUtility/issues"
    },
    "homepage": "https://github.com/shc0743/MyUtility/tree/main/js/lib/vue-dialog-view#readme"
}
